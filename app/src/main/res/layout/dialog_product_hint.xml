<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/dialog_surface"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/dialogSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="We couldn't find this barcode. Help our AI by describing the product (e.g., 'Erikli 1.5L Water')."
        android:textColor="@color/dialog_body"
        android:textSize="14sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/hintInputLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:hint="Product Category or Name"
        app:boxBackgroundColor="@color/dialog_input_surface"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/dialog_input_stroke"
        app:hintTextColor="@color/dialog_input_hint"
        app:startIconDrawable="@drawable/ic_ai_stars"
        app:startIconTint="@color/md_theme_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etProductHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLines="2"
            android:textColor="@color/dialog_input_text"
            android:textColorHint="@color/dialog_input_hint" />

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelAiSearch"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/dialog_ai_cancel_btn"
            android:textColor="@color/dialog_secondary_button_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearchWithAi"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:backgroundTint="@color/dialog_primary_button_bg"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:text="@string/dialog_ai_search_btn"
            android:textColor="@color/dialog_primary_button_text" />

    </LinearLayout>

</LinearLayout>
