rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profile: Publicly viewable for leaderboard, but only writable by owner.
    // This allows the collection-wide query used in the leaderboard.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // User Scans: Strictly private to the authenticated owner.
      match /scans/{scanId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Global Product Cache: Readable by all authenticated users.
    // Allow authenticated users to contribute data.
    match /global_products/{barcode} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
